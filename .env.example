# 이 파일을 .env로 복사하고 값을 직접 넣는다. .env는 저장소에 올라가지 않는다.
# 값은 대화·코드·문서에 쓰지 않는다.

# 공공데이터포털 인증키 (일반 인증키. Encoding·Decoding 어느 쪽이든 된다)
DATA_GO_KR_SERVICE_KEY=

# 슬랙 알림 (spec 009, ADR 0003). 슬랙 앱의 Bot User OAuth Token(xoxb-…)과, 슬랙에서 못 찾은 사람의 알림을 올릴 채널 ID(C…)
SLACK_BOT_TOKEN=
SLACK_FALLBACK_CHANNEL=

# 슬랙 [확인] 버튼 (spec 009 v0.6). 슬랙 앱 Basic Information의 Signing Secret,
# Supabase 프로젝트 Settings > API Keys의 secret 키(sb_secret_…). api/ 함수만 읽고 화면 코드에는 넣지 않는다
SLACK_SIGNING_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Claude 브리핑 (spec 022). 서버 함수(api/ai.js)만 읽고 화면 코드에는 넣지 않는다. 호출마다 비용이 든다(Haiku 5.5 기준 1센트 미만 추정).
# 실제 비용 상한은 Anthropic 콘솔의 워크스페이스 한도로 건다(키 소유자). 키가 없으면 AI 칸만 "키 없음"으로 안내하고 나머지 화면은 그대로다
ANTHROPIC_API_KEY=
# 선택: 모델을 바꿀 때만(5.x 모델). 비우면 claude-haiku-5-5
AI_MODEL=
# 로컬 시험 전용: fixtures로 두면 실제 Claude 대신 가짜 응답을 쓴다(Vercel에서는 꺼짐)
AI_MODE=

# 아침 브리핑 (spec 026). Vercel Cron이 부를 때 붙이는 비밀 값(아무 긴 무작위 글자). 같은 값을 Vercel 환경변수에도 넣는다
CRON_SECRET=
# 로컬 시험 전용: fixtures로 두면 슬랙·DB 대신 가짜 자료로 브리핑을 만든다(Vercel에서는 꺼짐)
BRIEFING_MODE=
